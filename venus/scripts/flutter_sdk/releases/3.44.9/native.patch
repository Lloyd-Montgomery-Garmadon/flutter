+  double paragraph_width;
+  double paragraph_height;
+  double box_width;
+  double box_height;
+  double min_intrinsic_width;
+  double max_intrinsic_width;
+  double alphabetic_baseline;
+  double ideographic_baseline;
+  double first_line_left;
+  uint64_t thread_id_hash;
+  uint64_t enqueue_ns;
+  uint64_t begin_ns;
+  uint64_t end_ns;
