+typedef struct FlutterVenusTextLayoutOutputV2 {
+  uint32_t struct_size;
+  int32_t status;
+  uint32_t error_field_id;
+  uint32_t error_detail;
+  uint32_t line_count;
+  uint32_t flags;
+  uint32_t worker_slot;
