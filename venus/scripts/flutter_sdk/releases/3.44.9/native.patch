+  const uint8_t* text;
+  const uint8_t* font_family;
+  const uint8_t* locale;
+  const uint8_t* ellipsis;
+  double min_width;
+  double max_width;
+  double min_height;
+  double max_height;
+  double font_size;
+  double letter_spacing;
+  double word_spacing;
+  double height;
+  double scaler_parameter;
