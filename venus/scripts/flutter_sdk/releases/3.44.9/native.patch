+void WriteU16(std::vector<uint8_t>& bytes, size_t offset, uint16_t value) {
+  bytes[offset] = static_cast<uint8_t>(value & 0xffu);
+  bytes[offset + 1u] = static_cast<uint8_t>((value >> 8u) & 0xffu);
+}
