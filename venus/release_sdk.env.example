# 复制为同目录的 release_sdk.env，填写本机路径（Bash 格式）。
VENUS_ROOT="/absolute/path/to/venus_engine"
# 每次发布换一个新目录；source/、build/、sdk/ 会生成在它下面。
VENUS_RELEASE_DIR="/absolute/path/to/flutter-sdk-release-3.44.9"

# 可选：构建工具设置。Windows Git Bash 通常使用 PYTHON=python。
# PYTHON=python3
# PATH="/absolute/path/to/depot_tools:$PATH"
